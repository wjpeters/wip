  "components": {
    "schemas": {
      "Confirmation": {
        "properties": {
          "preview_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Preview Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preview_id"
        ],
        "title": "Confirmation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderIntent": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "account_id": {
            "type": "string",
            "const": "demo-paper",
            "title": "Account Id",
            "default": "demo-paper"
          },
          "mode": {
            "type": "string",
            "const": "PAPER",
            "title": "Mode",
            "default": "PAPER"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side"
          },
          "order_type": {
            "type": "string",
            "const": "LIMIT",
            "title": "Order Type",
            "default": "LIMIT"
          },
          "time_in_force": {
            "type": "string",
            "const": "IOC",
            "title": "Time In Force",
            "default": "IOC"
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d{0,15})(?:\\.\\d{1,8})?$",
            "title": "Quantity"
          },
          "limit_price": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d{0,15})(?:\\.\\d{1,8})?$",
            "title": "Limit Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instrument_id",
          "side",
          "quantity",
          "limit_price"
        ],
        "title": "OrderIntent"
      },
      "Password": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "Password"
      },
      "Pause": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          }
        },
        "type": "object",
        "required": [
          "paused"
        ],
        "title": "Pause"
      },
      "Plan": {
        "properties": {
          "reserve": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d{0,15})(?:\\.\\d{1,8})?$",
            "title": "Reserve"
          },
          "monthly_in": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d{0,15})(?:\\.\\d{1,8})?$",
            "title": "Monthly In"
          },
          "monthly_out": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9]\\d{0,15})(?:\\.\\d{1,8})?$",
            "title": "Monthly Out"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reserve",
          "monthly_in",
          "monthly_out"
        ],
        "title": "Plan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
